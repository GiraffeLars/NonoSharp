<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Configurations>Debug;Release;Tests</Configurations>
		<PackageId>NonoSharp</PackageId>
		<Description>Nonogram API for .NET10.0 featuring randomly generated puzzles, custom puzzle file saving/loading and more</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/GiraffeLars/NonoSharp/</RepositoryUrl>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Authors>GiraffeLars</Authors>
		<PackageTags>nonogram;picross;puzzle</PackageTags>
		<PackageProjectUrl>https://giraffelars.github.io/NonoSharp/index.html</PackageProjectUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Title>NonoSharp</Title>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
